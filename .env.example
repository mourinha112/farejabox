# WhatsApp da FAREJA: só dígitos, com DDI (55) e DDD. Ex.: 5521999999999
NEXT_PUBLIC_WHATSAPP_NUMBER=5521986131173

# Endereço público do site (usado em metadados e compartilhamento)
NEXT_PUBLIC_SITE_URL=https://farejabox.com.br

# Opcional: webhook que recebe os leads do quiz (n8n, Make, CRM, planilha...)
LEAD_WEBHOOK_URL=

# Senha do painel /admin (mínimo 8 caracteres)
ADMIN_PASSWORD=

# Banco do funil: conecte um Upstash Redis na aba Storage da Vercel.
# A Vercel preenche KV_REST_API_URL e KV_REST_API_TOKEN sozinha.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternativa equivalente: UPSTASH_REDIS_REST_URL e UPSTASH_REDIS_REST_TOKEN.
# O checkout exige esse banco para registrar pedidos; sem banco não confirma compra.

# Opcional: Evolution API v2, apenas no servidor. Nunca usar prefixo NEXT_PUBLIC_.
# URL HTTPS da instalação (sem /message/sendText), chave e nome da instância conectada.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
